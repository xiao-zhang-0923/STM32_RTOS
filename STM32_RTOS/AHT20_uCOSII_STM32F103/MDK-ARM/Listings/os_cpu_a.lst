   76 0000000E         ;                                      void OSStartHighR
                       dy(void)
   77 0000000E         ;
   78 0000000E         ; 1) Set PendSV to the lowest priority.
   79 0000000E         ; 2) Set PSP = 0 so the first PendSV knows that no task 
                       context must be saved.
   80 0000000E         ; 3) Point MSP at the dedicated exception stack.
   81 0000000E         ; 4) Set OSRunning = TRUE, pend PendSV, enable interrupt
                       s.
   82 0000000E         ;*******************************************************
                       *************************************************
